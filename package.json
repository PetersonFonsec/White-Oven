{
  "name": "whiteoven",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @whiteoven/landing dev",
    "build": "pnpm --filter @whiteoven/landing build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "pnpm -r --if-present test && node --test tests/deployment/ops.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "start": "pnpm --filter @whiteoven/landing start",
    "leads": "pnpm --filter @whiteoven/landing exec node --env-file-if-exists=.env --experimental-strip-types scripts/leads.mjs",
    "test:containers": "node --experimental-strip-types tests/deployment/containers.mjs",
    "api:dev": "pnpm --filter @whiteoven/api dev",
    "api:build": "pnpm --filter @whiteoven/api build",
    "api:migrate": "pnpm --filter @whiteoven/api migrate",
    "api:seed-demo": "pnpm --filter @whiteoven/api seed-demo",
    "api:create-operator": "pnpm --filter @whiteoven/api create-operator",
    "admin:dev": "pnpm --filter @whiteoven/admin dev",
    "admin:build": "pnpm --filter @whiteoven/admin build",
    "mobile:start": "pnpm --filter @whiteoven/mobile start",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait postgres",
    "test:e2e:admin": "playwright test -c apps/admin/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "type": "module"
}
