{
  "name": "whiteoven",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @whiteoven/landing dev",
    "build": "pnpm --filter @whiteoven/landing build",
    "typecheck": "pnpm --filter @whiteoven/landing typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "pnpm --filter @whiteoven/landing test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2",
    "eslint-plugin-astro": "^1.3.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
