---
import "../styles/global.css";
import "../styles/immersive.css";
import tokens from "@whiteoven/design-tokens";

const cssTokens = Object.entries(tokens)
  .flatMap(([group, values]) =>
    Object.entries(values)
      .filter(([, value]) => typeof value !== "object")
      .map(([key, value]) => {
        const unit = ["spacing", "radius", "fontSize", "breakpoint"].includes(
          group,
        )
          ? "px"
          : group === "interaction"
            ? key === "durationMs"
              ? "ms"
              : "px"
            : "";
        return `--wo-${group}-${key}: ${value}${unit};`;
      }),
  )
  .join("\n");
const shadowCss = Object.entries(tokens.shadow)
  .map(
    ([name, shadow]) =>
      `--wo-shadow-${name}: ${shadow.offsetX}px ${shadow.offsetY}px ${shadow.blur}px rgb(37 37 37 / ${shadow.opacity});`,
  )
  .join("\n");

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16110D" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="WhiteOven" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Gate entrance states on JavaScript. The intro plays on fresh visits only (no storage is used) and never with reduced motion.
      (function () {
        const root = document.documentElement;
        root.classList.add("js");
        const [navigation] = performance.getEntriesByType("navigation");
        if (
          navigation?.type === "navigate" &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          root.classList.add("js-intro");
        }
      })();
    </script>
    <style set:html={`:root { ${cssTokens} ${shadowCss} }`}></style>
  </head>
  <body>
    <a class="skip-link" href="#inicio">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
