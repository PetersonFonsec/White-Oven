---
import BaseLayout from "../layouts/BaseLayout.astro";

const benefits = [
  {
    number: "01",
    title: "Seu app, sua marca",
    description:
      "Uma experiência própria para seus clientes, com a identidade da sua pizzaria.",
  },
  {
    number: "02",
    title: "Pizza do jeito de cada um",
    description:
      "Um montador visual para combinar sabores e ingredientes, inclusive meio a meio.",
  },
  {
    number: "03",
    title: "Operação em um só lugar",
    description:
      "Cardápio, pedidos e relacionamento com clientes planejados para trabalhar juntos.",
  },
];
---

<BaseLayout
  title="WhiteOven — sua pizzaria no centro da experiência"
  description="Conheça o WhiteOven: uma plataforma white label em desenvolvimento para pizzarias criarem uma experiência digital com a própria marca."
>
  <header class="wrap header">
    <a class="brand" href="#inicio" aria-label="WhiteOven, início">
      <span class="brand-mark" aria-hidden="true">W</span>
      <span>white<span>oven</span></span>
    </a>
    <nav aria-label="Navegação principal">
      <a href="#plataforma">A plataforma</a>
      <a href="#novidades">Novidades</a>
    </nav>
  </header>

  <main id="inicio" tabindex="-1">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">Tecnologia com sabor de casa</p>
        <h1>Sua pizzaria merece um app com a <em>sua cara.</em></h1>
        <p class="hero-text">
          O WhiteOven está sendo criado para ajudar pizzarias a oferecer uma
          experiência digital própria — do primeiro toque à escolha de cada
          ingrediente.
        </p>
        <a class="button" href="#plataforma"
          >Conheça a ideia <span aria-hidden="true">↗</span></a
        >
        <p class="launch-note">Estamos preparando os primeiros passos.</p>
      </div>
      <figure class="hero-art">
        <img
          src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1200&q=85"
          alt="Pizza com queijo derretido, tomate e manjericão fresco sobre uma mesa"
          width="1200"
          height="1200"
          fetchpriority="high"
        />
        <figcaption class="art-label">
          Sua marca. Seu jeito. Sua pizza.
        </figcaption>
      </figure>
    </section>

    <section class="intro" id="plataforma">
      <div class="wrap intro-inner">
        <p class="eyebrow">O próximo capítulo da sua pizzaria</p>
        <h2>
          Mais do que pedir pizza.<br /><em>Uma experiência para lembrar.</em>
        </h2>
        <p>
          Queremos aproximar pizzarias e seus clientes com ferramentas digitais
          que valorizem cada marca e deixem a personalização tão gostosa quanto
          a primeira fatia.
        </p>
      </div>
    </section>

    <section class="benefits wrap" aria-label="O que estamos planejando">
      {
        benefits.map((benefit) => (
          <article class="benefit">
            <span class="benefit-number">{benefit.number}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </article>
        ))
      }
    </section>

    <section class="closing" id="novidades">
      <div class="wrap closing-inner">
        <span class="closing-icon" aria-hidden="true">✳</span>
        <p class="eyebrow">WhiteOven está em desenvolvimento</p>
        <h2>Uma nova forma de pedir<br />está <em>saindo do forno.</em></h2>
        <p>Em breve, mais novidades sobre a plataforma.</p>
      </div>
    </section>
  </main>

  <footer class="wrap footer">
    <a class="brand" href="#inicio"
      ><span class="brand-mark" aria-hidden="true">W</span><span
        >white<span>oven</span></span
      ></a
    >
    <p>© {new Date().getFullYear()} WhiteOven. Feito para pizzarias.</p>
  </footer>
</BaseLayout>

<style>
  .header {
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wo-spacing-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--wo-spacing-2);
    font-size: 1.4rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.06em;
  }
  .brand-mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--wo-radius-small);
    background: var(--wo-color-primary);
    color: var(--wo-color-onPrimary);
  }
  nav {
    display: flex;
    gap: var(--wo-spacing-5);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: var(--wo-fontSize-small);
    font-weight: 700;
  }
  nav a:hover {
    color: var(--wo-color-accentText);
    text-decoration: underline;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: var(--wo-spacing-7);
    padding-block: var(--wo-spacing-8) var(--wo-spacing-9);
  }
  h1 {
    margin: var(--wo-spacing-5) 0;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    letter-spacing: -0.055em;
    line-height: var(--wo-lineHeight-heading);
  }
  h1 em,
  h2 em {
    color: var(--wo-color-accentText);
    font-style: normal;
  }
  .hero-text {
    color: var(--wo-color-muted);
    font-size: var(--wo-fontSize-lead);
    margin-bottom: var(--wo-spacing-6);
  }
  .button span {
    margin-left: var(--wo-spacing-3);
  }
  .launch-note {
    color: var(--wo-color-muted);
    font-size: var(--wo-fontSize-small);
  }
  .hero-art {
    position: relative;
    margin: 0;
    padding: var(--wo-spacing-3);
    background: var(--wo-color-surface);
    border-radius: var(--wo-radius-large);
    box-shadow: var(--wo-shadow-card);
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--wo-radius-card);
    background: var(--wo-color-loading);
  }
  .art-label {
    position: absolute;
    bottom: var(--wo-spacing-6);
    left: var(--wo-spacing-6);
    right: var(--wo-spacing-6);
    padding: var(--wo-spacing-4);
    border-radius: var(--wo-radius-small);
    background: var(--wo-color-surface);
    font-weight: 700;
    text-align: center;
  }
  .intro {
    padding-block: var(--wo-spacing-8);
    background: var(--wo-color-surface);
    text-align: center;
  }
  .intro-inner {
    max-width: 760px;
  }
  h2 {
    margin: var(--wo-spacing-4) 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .intro-inner > p:last-child {
    color: var(--wo-color-muted);
    max-width: 640px;
    margin: var(--wo-spacing-5) auto 0;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--wo-spacing-5);
    padding-block: var(--wo-spacing-8);
  }
  .benefit {
    padding: var(--wo-spacing-6);
    border-radius: var(--wo-radius-card);
    background: var(--wo-color-surface);
    box-shadow: var(--wo-shadow-card);
  }
  .benefit-number {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--wo-color-primary);
    border-radius: var(--wo-radius-small);
    font-weight: 800;
  }
  .benefit h3 {
    font-size: 1.35rem;
    line-height: 1.3;
    margin-block: var(--wo-spacing-5) var(--wo-spacing-3);
  }
  .benefit p {
    color: var(--wo-color-muted);
    margin: 0;
  }
  .closing {
    padding-block: var(--wo-spacing-8);
    background: var(--wo-color-primary);
    text-align: center;
  }
  .closing .eyebrow,
  .closing h2 em {
    color: var(--wo-color-text);
  }
  .closing-icon {
    font-size: 2rem;
  }
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wo-spacing-5);
    padding-block: var(--wo-spacing-6);
  }
  .footer p {
    color: var(--wo-color-muted);
    font-size: var(--wo-fontSize-small);
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: var(--wo-spacing-6);
    }
    .hero-art {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
    .benefits {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .header {
      flex-wrap: wrap;
      padding-block: var(--wo-spacing-4);
      gap: var(--wo-spacing-2);
    }
    nav {
      gap: var(--wo-spacing-4);
    }
    .footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer p {
      margin: 0;
    }
  }
</style>
