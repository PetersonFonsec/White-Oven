---
import SectionHeading from "./SectionHeading.astro";
import PizzaArtwork from "./PizzaArtwork.astro";
import { flavors } from "../lib/pizza";
---

<section
  class="builder section"
  id="demonstracao"
  aria-labelledby="builder-title"
>
  <p class="builder-bigword" aria-hidden="true">meio a meio</p>
  <div class="wrap">
    <SectionHeading
      eyebrow="Menos imaginação. Mais sabor."
      title="Monte uma pizza. Sinta a diferença."
      id="builder-title"
      description="Explore uma prévia do Pizza Builder: sabores e ingredientes em cada metade, do jeito que seu cliente poderá escolher."
      centered
    />
    <div class="builder-card" data-builder>
      <div class="builder-visual">
        <div class="builder-visual-top">
          <span class="tag">Demonstração interativa</span><span
            class="builder-size">35 cm · 8 fatias</span
          >
        </div>
        <div class="builder-plate">
          <span class="builder-orbit" aria-hidden="true"></span>
          <span class="builder-board" aria-hidden="true"></span>
          <PizzaArtwork id="builder-pizza" interactive />
          <div class="half-callout half-callout--left" aria-hidden="true">
            <span data-left-side>Metade esquerda</span><strong data-left-label
              >Calabresa</strong
            ><small data-left-callout>Calabresa, cebola e muçarela</small>
          </div>
          <div
            class="half-callout half-callout--right"
            aria-hidden="true"
            data-right-callout-box
          >
            <span>Metade direita</span><strong data-right-label
              >Margherita</strong
            ><small data-right-callout>Tomate, manjericão e muçarela</small>
          </div>
        </div>
        <p class="small muted">
          Prévia visual · tamanho demonstrativo de 35 cm
        </p>
      </div>
      <div class="builder-controls">
        <p class="eyebrow">Uma pizza, suas combinações</p><h3>
          Qual vai ser a sua?
        </h3>
        <noscript
          ><p class="notice">
            Ative o JavaScript para alterar sabores e preços nesta demonstração.
          </p></noscript
        >
        <fieldset class="builder-fields" disabled>
          <legend class="sr-only">Configure sua pizza demonstrativa</legend>
          <fieldset class="mode-options">
            <legend>1. Escolha o formato</legend><label
              ><input type="radio" name="pizza-mode" value="whole" /><span
                class="mode-icon mode-icon--whole"
                aria-hidden="true"></span>Inteira</label
            ><label
              ><input
                type="radio"
                name="pizza-mode"
                value="halves"
                checked
              /><span class="mode-icon mode-icon--halves" aria-hidden="true"
              ></span>Meio a meio</label
            >
          </fieldset>
          <div class="flavor-selects">
            <label for="flavor-left" data-flavor-control="left"
              ><span data-left-heading>2. Metade esquerda</span><span
                class="select-wrap"
                ><span class="flavor-swatch" aria-hidden="true"></span><select
                  id="flavor-left"
                  >{
                    flavors.map((flavor) => (
                      <option
                        value={flavor.id}
                        selected={flavor.id === "calabresa"}
                      >
                        {flavor.name}
                      </option>
                    ))
                  }</select
                ></span
              ><small data-left-ingredients>Calabresa, cebola e muçarela</small
              ></label
            ><label
              for="flavor-right"
              data-right-control
              data-flavor-control="right"
              ><span>3. Metade direita</span><span class="select-wrap"
                ><span class="flavor-swatch" aria-hidden="true"></span><select
                  id="flavor-right"
                  >{
                    flavors.map((flavor) => (
                      <option
                        value={flavor.id}
                        selected={flavor.id === "margherita"}
                      >
                        {flavor.name}
                      </option>
                    ))
                  }</select
                ></span
              ><small data-right-ingredients
                >Tomate, manjericão e muçarela</small
              ></label
            >
          </div>
        </fieldset>
        <div class="builder-receipt">
          <p class="builder-receipt-title">Resumo da pizza</p>
          <dl>
            <div>
              <dt data-left-line>½ Calabresa</dt><dd data-left-price>
                R$ 49,00
              </dd>
            </div><div data-right-line-row>
              <dt data-right-line>½ Margherita</dt><dd data-right-price>
                R$ 52,00
              </dd>
            </div><div class="builder-receipt-rule" data-rule-row>
              <dt>Meio a meio</dt><dd>vale o maior preço</dd>
            </div>
          </dl>
          <div class="builder-price">
            <div>
              <span class="small muted">Preço demonstrativo</span><strong
                data-price>R$ 52,00</strong
              >
            </div><span class="tag">Sem pedido real</span>
          </div>
        </div>
        <p class="small muted">
          Valores fictícios. No meio a meio, vale o maior preço entre os dois
          sabores. Não há checkout ou envio de pedidos.
        </p>
        <p
          class="sr-only"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-builder-status
        >
          Metade esquerda: Calabresa. Metade direita: Margherita. Preço
          demonstrativo: R$ 52,00.
        </p>
      </div>
    </div>
  </div>
</section>
<script>
  import {
    initialSelection,
    selectFlavor,
    selectMode,
    getFlavor,
    describePizza,
    formatPrice,
    priceInCents,
    type FlavorId,
  } from "../lib/pizza";
  const builder = document.querySelector<HTMLElement>("[data-builder]");
  if (builder) {
    let selection = { ...initialSelection };
    const left = builder.querySelector<HTMLSelectElement>("#flavor-left")!;
    const right = builder.querySelector<HTMLSelectElement>("#flavor-right")!;
    const text = (selector: string, value: string) => {
      const element = builder.querySelector(selector);
      if (element) element.textContent = value;
    };
    // Swatch colours follow the toppings drawn on the artwork.
    const swatches: Record<FlavorId, string> = {
      calabresa: "#a93727",
      margherita: "#416a37",
      frango: "#b57b3c",
      queijos: "#efa340",
    };
    const price = builder.querySelector<HTMLElement>("[data-price]")!;
    let rendered = false;
    const bump = () => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      price.animate(
        [
          { transform: "scale(1)" },
          { transform: "scale(1.12)", color: "var(--wo-color-accentText)" },
          { transform: "scale(1)" },
        ],
        { duration: 450, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
      );
    };
    const render = () => {
      const whole = selection.mode === "whole";
      const leftFlavor = getFlavor(selection.left);
      const rightFlavor = getFlavor(selection.right);
      builder
        .querySelectorAll<HTMLElement>("[data-flavor-control]")
        .forEach((control) =>
          control.style.setProperty(
            "--flavor",
            swatches[
              control.dataset.flavorControl === "left"
                ? selection.left
                : selection.right
            ],
          ),
        );
      text("[data-left-side]", whole ? "Pizza inteira" : "Metade esquerda");
      text("[data-left-callout]", leftFlavor.ingredients);
      text("[data-right-callout]", rightFlavor.ingredients);
      builder.querySelector<HTMLElement>("[data-right-callout-box]")!.hidden =
        whole;
      text("[data-left-line]", `${whole ? "Inteira" : "½"} ${leftFlavor.name}`);
      text("[data-left-price]", formatPrice(leftFlavor.price));
      text("[data-right-line]", `½ ${rightFlavor.name}`);
      text("[data-right-price]", formatPrice(rightFlavor.price));
      builder
        .querySelectorAll<HTMLElement>("[data-right-line-row], [data-rule-row]")
        .forEach((row) => (row.hidden = whole));
      builder.dataset.mode = selection.mode;
      right.disabled = whole;
      builder.querySelector<HTMLElement>("[data-right-control]")!.hidden =
        whole;
      const description = describePizza(selection);
      text("[data-pizza-art] title", description);
      text(
        "[data-left-heading]",
        whole ? "2. Sabor da pizza" : "2. Metade esquerda",
      );
      text("[data-left-ingredients]", getFlavor(selection.left).ingredients);
      text("[data-right-ingredients]", getFlavor(selection.right).ingredients);
      text("[data-left-label]", leftFlavor.name);
      text("[data-right-label]", rightFlavor.name);
      const total = formatPrice(priceInCents(selection));
      if (rendered && price.textContent !== total) bump();
      text("[data-price]", total);
      rendered = true;
      text(
        "[data-builder-status]",
        `${description}. Preço demonstrativo: ${total}.`,
      );
      builder.querySelectorAll<SVGGElement>("[data-side]").forEach((side) => {
        const flavor: FlavorId =
          side.dataset.side === "left" || whole
            ? selection.left
            : selection.right;
        side.querySelectorAll<SVGGElement>("[data-flavor]").forEach((group) => {
          group.dataset.active = String(group.dataset.flavor === flavor);
        });
      });
    };
    left.value = selection.left;
    right.value = selection.right;
    left.addEventListener("change", () => {
      selection = selectFlavor(selection, "left", left.value);
      render();
    });
    right.addEventListener("change", () => {
      selection = selectFlavor(selection, "right", right.value);
      render();
    });
    builder
      .querySelectorAll<HTMLInputElement>("[name=pizza-mode]")
      .forEach((input) => {
        input.checked = input.value === selection.mode;
        input.addEventListener("change", () => {
          selection = selectMode(
            selection,
            input.value === "whole" ? "whole" : "halves",
          );
          render();
        });
      });
    builder.querySelector<HTMLFieldSetElement>(".builder-fields")!.disabled =
      false;
    render();
  }
</script>
