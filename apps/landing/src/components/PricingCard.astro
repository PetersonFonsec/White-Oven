---
import Button from "./Button.astro";
interface Props {
  plan: "flex" | "pro";
}
const { plan } = Astro.props;
const isPro = plan === "pro";
---

<article class:list={["pricing-card", { "pricing-card--pro": isPro }]}>
  <div class="pricing-top">
    <h3>WhiteOven {isPro ? "Pro" : "Flex"}</h3><span class="tag"
      >{isPro ? "Custo mensal previsível" : "Para começar no seu ritmo"}</span
    >
  </div>
  <p class="price">{isPro ? "R$ 199" : "R$ 0"}<span>/mês</span></p>
  <p class="commission">
    {
      isPro
        ? "Sem comissão WhiteOven sobre vendas."
        : "3% por venda paga pelo aplicativo."
    }
  </p>
  <ul class="check-list">
    <li>Aplicativo personalizado</li><li>Painel administrativo</li><li>
      Funcionalidades essenciais do WhiteOven
    </li><li>Mesmas funcionalidades no MVP</li>
  </ul>
  <Button
    href="#interesse"
    plan={plan}
    variant={isPro ? "primary" : "secondary"}
    >Tenho interesse no {isPro ? "Pro" : "Flex"}</Button
  >
</article>
