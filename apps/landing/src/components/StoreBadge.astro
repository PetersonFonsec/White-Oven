---
interface Props {
  store: "apple" | "google";
  url?: string;
}
const { store, url } = Astro.props;
const validUrl =
  url &&
  (store === "apple"
    ? /^https:\/\/apps\.apple\.com\//
    : /^https:\/\/play\.google\.com\//
  ).test(url)
    ? url
    : undefined;
const Tag = validUrl ? "a" : "div";
---

<Tag
  class="store-badge"
  href={validUrl}
  aria-label={validUrl
    ? `Ver aplicativo na ${store === "apple" ? "App Store" : "Google Play"}`
    : undefined}
>
  <svg width="27" height="30" viewBox="0 0 30 32" aria-hidden="true"
    >{
      store === "apple" ? (
        <>
          <path
            d="M20 2c0 5-4 7-6 7 0-4 3-7 6-7ZM24 24c-2 4-3 6-5 6-2 0-3-1-5-1s-3 1-5 1c-3 0-7-7-7-13 0-5 3-8 7-8 2 0 4 1 5 1 2 0 4-2 7-1 1 0 3 1 4 3-6 4-5 9-1 12Z"
            fill="currentColor"
          />
        </>
      ) : (
        <>
          <>
            <path
              d="m3 3 17 13L3 29Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="m3 3 25 13L3 29m17-13 5-3m-5 3 5 3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
          </>
        </>
      )
    }</svg
  >
  <span
    ><small>{validUrl ? "Conheça o aplicativo" : "Em breve"}</small><strong
      >{store === "apple" ? "App Store" : "Google Play"}</strong
    ></span
  >
</Tag>
