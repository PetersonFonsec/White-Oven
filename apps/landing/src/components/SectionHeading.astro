---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
  id?: string;
}
const { eyebrow, title, description, centered, id } = Astro.props;
---

<div class:list={["section-heading", { "section-heading--center": centered }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
