---
interface Props {
  number: string;
  title: string;
  description: string;
  icon: string;
}
const { number, title, description, icon } = Astro.props;
---

<article class="feature-card">
  <div class="feature-top">
    <span class="feature-icon" aria-hidden="true">{icon}</span><span
      class="feature-number">{number}</span
    >
  </div>
  <h3>{title}</h3><p>{description}</p>
</article>
