---
import SectionHeading from "./SectionHeading.astro";
---

<section
  class="interest section"
  id="interesse"
  aria-labelledby="interest-title"
>
  <div class="wrap interest-grid">
    <div>
      <SectionHeading
        eyebrow="Vamos construir essa próxima fatia?"
        title="Sua pizzaria pode fazer parte dessa história."
        id="interest-title"
        description="Estamos preparando o acesso antecipado do WhiteOven. Em breve, você poderá manifestar seu interesse por aqui."
      />
      <div class="notice" id="form-notice">
        <strong>Inscrições em breve</strong><p>
          Este formulário é um protótipo. O envio está desabilitado: seus dados
          não são enviados nem salvos. Nenhuma inscrição será realizada nesta
          página.
        </p>
      </div>
      <p class="small muted">
        Condições comerciais preliminares, sujeitas a validação. Sem contratação
        ou cobrança nesta etapa.
      </p>
    </div>
    <form
      class="lead-form"
      id="interest-form"
      aria-describedby="form-notice"
      autocomplete="off"
    >
      <noscript
        ><p class="notice">
          Este protótipo requer JavaScript para editar os campos. As inscrições
          ainda não estão disponíveis.
        </p></noscript
      >
      <fieldset class="lead-fields" disabled>
        <legend class="sr-only">Demonstração do formulário de interesse</legend>
        <div class="form-row">
          <label for="responsible"
            >Nome do responsável<input
              id="responsible"
              type="text"
              placeholder="Como podemos chamar você?"
              maxlength="100"
            /></label
          ><label for="pizzeria"
            >Nome da pizzaria<input
              id="pizzeria"
              type="text"
              placeholder="O nome da sua marca"
              maxlength="150"
            /></label
          >
        </div>
        <label for="whatsapp"
          >WhatsApp comercial<input
            id="whatsapp"
            type="tel"
            inputmode="tel"
            placeholder="(11) 99999-9999"
            maxlength="25"
          /></label
        >
        <div class="form-row">
          <label for="volume"
            >Pedidos por mês<select id="volume"
              ><option value="">Selecione uma faixa</option><option
                value="under-300">Até 300</option
              ><option value="300-1000">301 a 1.000</option><option
                value="1000-3000">1.001 a 3.000</option
              ><option value="over-3000">Mais de 3.000</option></select
            ></label
          ><label for="plan"
            >Plano de interesse<select id="plan"
              ><option value="undecided">Ainda estou avaliando</option><option
                value="flex">Flex — 3% por venda</option
              ><option value="pro">Pro — R$ 199/mês</option></select
            ></label
          >
        </div>
        <label class="consent" for="consent"
          ><input id="consent" type="checkbox" /><span
            >Gostaria de receber contato sobre o WhiteOven quando as inscrições
            estiverem disponíveis. Este protótipo não registra consentimento.</span
          ></label
        >
        <button class="button" type="submit" disabled
          >Inscrições disponíveis em breve</button
        >
        <p
          class="small muted"
          id="plan-status"
          role="status"
          aria-live="polite"
        >
          Nenhum dado será cadastrado.
        </p>
      </fieldset>
    </form>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#interest-form");
  // Enable prototype controls only after the submission guard is attached.
  // A real POST action, field names and submission states belong to M0.1-B.
  if (form) {
    form.addEventListener("submit", (event) => event.preventDefault());
    form.querySelector<HTMLFieldSetElement>(".lead-fields")!.disabled = false;
  }
  const plan = document.querySelector<HTMLSelectElement>("#plan");
  const status = document.querySelector<HTMLElement>("#plan-status");
  document
    .querySelectorAll<HTMLAnchorElement>("a[data-plan]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        const selected = link.dataset.plan;
        if (plan && (selected === "flex" || selected === "pro")) {
          plan.value = selected;
          if (status)
            status.textContent = `Plano ${selected === "flex" ? "Flex" : "Pro"} selecionado para demonstração. Nenhum dado será cadastrado.`;
        }
      });
    });
</script>
