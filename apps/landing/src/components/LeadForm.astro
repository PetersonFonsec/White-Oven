---
import { CONTACT_CONSENT_TEXT } from "@whiteoven/contracts";
import SectionHeading from "./SectionHeading.astro";
---

<section
  class="interest section"
  id="interesse"
  aria-labelledby="interest-title"
>
  <div class="wrap interest-grid">
    <div>
      <SectionHeading
        eyebrow="Vamos construir essa próxima fatia?"
        title="Vamos abrir esse forno?"
        id="interest-title"
        description="Deixe seu interesse em acesso antecipado. Nossa equipe poderá conversar com você sobre o WhiteOven."
      />
      <div class="notice" id="form-notice">
        <strong>Acesso antecipado</strong><p
          id="availability-status"
          role="status"
        >
          Verificando disponibilidade das inscrições…
        </p>
      </div>
      <p class="small muted">
        Condições comerciais preliminares, sujeitas a validação. Sem contratação
        ou cobrança nesta etapa.
      </p>
    </div>
    <form
      class="lead-form"
      id="interest-form"
      aria-describedby="form-notice"
      method="post"
      action="/api/leads"
      novalidate
    >
      <noscript
        ><p class="notice">
          Ative JavaScript para consultar a disponibilidade e enviar seu
          interesse com segurança.
        </p></noscript
      >
      <fieldset class="lead-fields" disabled>
        <legend class="sr-only">Formulário de interesse</legend>
        <div class="form-row">
          <label for="responsible"
            >Nome do responsável<input
              id="responsible"
              name="responsibleName"
              required
              autocomplete="name"
              type="text"
              placeholder="Como podemos chamar você?"
              maxlength="100"
            /></label
          ><label for="pizzeria"
            >Nome da pizzaria<input
              id="pizzeria"
              name="pizzeriaName"
              required
              autocomplete="organization"
              type="text"
              placeholder="O nome da sua marca"
              maxlength="150"
            /></label
          >
        </div>
        <label for="whatsapp"
          >WhatsApp comercial<input
            id="whatsapp"
            name="whatsapp"
            required
            autocomplete="tel"
            type="tel"
            inputmode="tel"
            placeholder="(11) 99999-9999"
            maxlength="25"
          /></label
        >
        <div class="form-row">
          <label for="volume"
            >Pedidos por mês<select
              id="volume"
              name="monthlyOrderVolume"
              required
              ><option value="">Selecione uma faixa</option><option
                value="UP_TO_300">Até 300</option
              ><option value="FROM_301_TO_1000">301 a 1.000</option><option
                value="FROM_1001_TO_3000">1.001 a 3.000</option
              ><option value="OVER_3000">Mais de 3.000</option></select
            ></label
          ><label for="plan"
            >Plano de interesse<select id="plan" name="interestedPlan" required
              ><option value="UNDECIDED">Ainda estou avaliando</option><option
                value="FLEX">Flex — 3% por venda</option
              ><option value="PRO">Pro — R$ 199/mês</option></select
            ></label
          >
        </div>
        <label class="consent" for="consent"
          ><input
            id="consent"
            name="contactConsent"
            required
            type="checkbox"
          /><span
            >{CONTACT_CONSENT_TEXT}
            <a href="/privacidade" target="_blank" rel="noopener"
              >Ler política de privacidade (nova aba)</a
            ></span
          ></label
        >
        <div hidden aria-hidden="true">
          <label
            >Site<input
              name="website"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>
        <button class="button" type="submit" disabled
          >Registrar meu interesse</button
        >
        <p
          class="small muted"
          id="plan-status"
          role="status"
          aria-live="polite"
        >
          Escolha o plano que faz sentido para sua pizzaria.
        </p>
      </fieldset>
      <p id="form-result" role="status" aria-live="polite" tabindex="-1"></p>
    </form>
  </div>
</section>

<script>
  import "../scripts/lead-form";
</script>

<style>
  .lead-form :global([aria-invalid="true"]) {
    border-color: var(--wo-color-error);
  }
  .lead-form :global([data-field-error]) {
    color: var(--wo-color-error);
    display: block;
  }
  #form-result[data-state="error"] {
    color: var(--wo-color-error);
  }
  #form-result[data-state="success"] {
    color: var(--wo-color-success);
  }
</style>
