# Copie para apps/landing/.env. Não versione o arquivo preenchido.
LEADS_ENABLED=false
SITE_ORIGIN=http://localhost:4321
LEADS_DB_PATH=.data/leads.dev.sqlite
# Identificação real do controlador e contato autorizado para publicação:
LEADS_CONTROLLER_NAME=
LEADS_PRIVACY_EMAIL=
# Servidor standalone (pnpm start):
HOST=127.0.0.1
PORT=4321

# Vazio: use somente o IP da conexão. Proxies precisam sobrescrever X-Forwarded-For.
# Liste IPs exatos do último proxy confiável, sem CIDR ou wildcard.
LEADS_TRUSTED_PROXIES=
