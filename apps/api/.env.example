# Copie para .env apenas em desenvolvimento local. Valores inválidos impedem o start.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# debug | info | warn | error
API_LOG_LEVEL=info
# true | false. Padrão: true fora de produção, false em produção.
API_OPENAPI_ENABLED=true

# Banco: `pnpm db:up` sobe o PostgreSQL de desenvolvimento (compose.dev.yaml) em 127.0.0.1:5432.
# A API conecta SOMENTE como whiteoven_app; whiteoven_owner é recusado. Senhas são de desenvolvimento.
DATABASE_URL=postgres://whiteoven_app:whiteoven-dev-app-password@127.0.0.1:5432/whiteoven
# 1-100. Padrão: 10.
DATABASE_POOL_MAX=10
# Credenciais do dono (migrations) ficam em .env.migrate; a API recusa iniciar se DATABASE_OWNER_URL existir.
