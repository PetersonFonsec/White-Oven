# Copie para .env apenas em desenvolvimento local. Valores inválidos impedem o start.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# debug | info | warn | error
API_LOG_LEVEL=info
# true | false. Padrão: true fora de produção, false em produção.
API_OPENAPI_ENABLED=true

# Banco: `pnpm db:up` sobe o PostgreSQL de desenvolvimento (compose.dev.yaml) em 127.0.0.1:5432.
# A API conecta SOMENTE como whiteoven_app; whiteoven_owner é recusado. Senhas são de desenvolvimento.
DATABASE_URL=postgres://whiteoven_app:whiteoven-dev-app-password@127.0.0.1:5432/whiteoven
# 1-100. Padrão: 10.
DATABASE_POOL_MAX=10
# Credenciais do dono (migrations) ficam em .env.migrate; a API recusa iniciar se DATABASE_OWNER_URL existir.

# Autenticação da equipe (ADR 0007). Chave Ed25519 PKCS#8 DER em base64; obrigatória em produção.
# Fora de produção, vazia = chave efêmera gerada no boot (tokens morrem com o processo).
AUTH_ACCESS_TOKEN_PRIVATE_KEY=
# 32 bytes em base64 (AES-256-GCM dos segredos TOTP); obrigatória em produção. Vazia = efêmera
# (cadastros de MFA não sobrevivem ao restart). Gere com: openssl rand -base64 32
AUTH_MFA_ENCRYPTION_KEY=
# 32 bytes em base64; segredo exclusivo e persistente para convites OWNER. Obrigatório em produção.
# Gere com: openssl rand -base64 32
OWNER_INVITE_SECRET=
# Origens do painel aceitas no refresh/logout por cookie, separadas por vírgula.
API_ADMIN_ORIGINS=
