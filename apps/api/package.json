{
  "name": "@whiteoven/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --enable-source-maps --test \"dist/tests/test/**/*.test.js\"",
    "migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env.migrate --enable-source-maps dist/database/migrate.js",
    "seed-demo": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --env-file-if-exists=.env.migrate --enable-source-maps dist/database/seed-demo.js",
    "create-operator": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/auth/create-operator.js",
    "e2e-server": "tsc -p tsconfig.test.json && node --enable-source-maps dist/tests/test/e2e-server.js"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "@whiteoven/contracts": "workspace:*",
    "@whiteoven/pizza-pricing": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
