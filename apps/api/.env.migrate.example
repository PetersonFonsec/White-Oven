# Copie para .env.migrate. Usado apenas por `pnpm api:migrate` (dist/database/migrate.js), nunca pela API.
DATABASE_OWNER_URL=postgres://whiteoven_owner:whiteoven-dev-owner-password@127.0.0.1:5432/whiteoven
# Opcionais: definem a senha de login dos papéis de runtime após as migrations (16-128 ASCII).
DATABASE_APP_PASSWORD=whiteoven-dev-app-password
DATABASE_PLATFORM_PASSWORD=whiteoven-dev-platform-password
