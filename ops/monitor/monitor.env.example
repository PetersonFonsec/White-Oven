# Monitor da API (ADR 0032, docs/operations/observability.md). Copie para /etc/whiteoven/monitor.env
# com permissão 0600. Nunca versione o arquivo preenchido.

# Endereço interno da API (o proxy público responde 404 em /metrics).
MONITOR_API_URL=http://127.0.0.1:3000
# Mesmo valor de API_METRICS_TOKEN da API. Sem ele, só o alerta de indisponibilidade roda.
MONITOR_METRICS_TOKEN=
# Webhook do canal escolhido pelo PO (https). Segredo.
MONITOR_WEBHOOK_URL=
# text ({"text"}: Slack, Mattermost, Google Chat) | discord ({"content"}) | json (estruturado)
MONITOR_WEBHOOK_FORMAT=text
# Nome curto do ambiente nas mensagens.
MONITOR_ENVIRONMENT=piloto

# Limites (padrões entre parênteses).
# MONITOR_DOWN_AFTER=2            verificações seguidas com falha para alertar (1-10)
# MONITOR_WINDOW_MINUTES=10       janela de erro e latência (1-60)
# MONITOR_MIN_REQUESTS=20         requisições mínimas na janela para avaliar um grupo
# MONITOR_ERROR_RATE=0.05         fração de 5xx que dispara o alerta
# MONITOR_LATENCY_P95_SECONDS=2.5 limite do p95 (comparado ao limite superior do balde)
# MONITOR_REPEAT_MINUTES=60       repetição de alerta ainda ativo (5-1440)
# MONITOR_TIMEOUT_SECONDS=5       timeout de /health/ready e /metrics (1-30)
# MONITOR_INTERVAL_SECONDS=60     só no modo watch (15-3600)
