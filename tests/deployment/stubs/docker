#!/usr/bin/env bash
# Test double for the docker CLI used by ops scripts. State lives in $STUB_STATE.
set -u
s="$STUB_STATE"
echo "docker $*" >> "$s/log"
resolve() { if [[ "$1" == sha256:* ]]; then echo "$1"; else echo "sha256:${1//[^a-zA-Z0-9]/}"; fi; }
flag() { [[ -f "$s/$1" ]] && grep -qxF "$2" "$s/$1"; }
if [[ "$1" == compose ]]; then
 shift
 env_file=""
 while [[ "$1" == --env-file || "$1" == -f ]]; do [[ "$1" == --env-file ]] && env_file="$2"; shift 2; done
 configured="${WHITEOVEN_IMAGE:-$(sed -n 's/^WHITEOVEN_IMAGE=//p' "$env_file")}"
 case "$1" in
  config) [[ "${2:-}" == --images ]] && echo "$configured"; exit 0 ;;
  up)
   id="$(resolve "$configured")"
   echo "$id" > "$s/running"
   if flag unhealthy "$id"; then echo bad > "$s/health"; exit 1; fi
   echo ok > "$s/health"; exit 0 ;;
  stop) rm -f "$s/running"; exit 0 ;;
  ps) [[ -f "$s/running" ]] && echo "c-$(cat "$s/running")"; exit 0 ;;
  exec)
   if [[ "$*" == *healthcheck.mjs* ]]; then [[ -f "$s/running" && "$(cat "$s/health")" == ok ]]; exit; fi
   exit 0 ;;
  *) exit 0 ;;
 esac
fi
case "$1" in
 image)
  if [[ "$2" == inspect && "$3" == --format ]]; then resolve "$5"; exit 0; fi
  exit 0 ;;
 pull|tag) exit 0 ;;
 run)
  while [[ "$1" != --entrypoint ]]; do shift; done
  ! flag invalid "$(resolve "$3")" ;;
 inspect)
  if [[ "$3" == *revision* ]]; then echo "${STUB_REVISION:-}"; exit 0; fi
  echo "${4#c-}" ;;
 manifest)
  if [[ -f "$s/manifest-exists" ]]; then exit 0; fi
  cat "$s/manifest-error" >&2 2>/dev/null; exit 1 ;;
 push)
  [[ -f "$s/push-fails" ]] && { echo 'push failed: connection reset' >&2; exit 1; }
  [[ -f "$s/push-unconfirmed" ]] || touch "$s/manifest-exists"
  exit 0 ;;
 *) exit 0 ;;
esac
